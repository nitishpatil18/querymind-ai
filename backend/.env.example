# Local development settings (run from backend/). Copy to .env and edit. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data

# Runtime connection: the READ-ONLY role. The running API never needs admin credentials.
DATABASE_URL=postgresql+psycopg://querymind_ro:change_me_ro@localhost:5432/querymind
# Only for scripts/initialize_database.py and scripts/seed_database.py
DATABASE_ADMIN_URL=postgresql+psycopg://querymind:change_me_admin@localhost:5432/querymind
APP_SCHEMAS=public

# LLM (Gemini through langchain-google-genai). Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Gemini 3+ thinking effort: minimal, low, medium, high. Empty uses the model default (slower).
LLM_THINKING_LEVEL=
GOOGLE_API_KEY=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
GENERATION_MAX_ATTEMPTS=3

# Embeddings / retrieval
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=10
RETRIEVAL_MAX_TABLES=4
RETRIEVAL_EXPAND_MAX=3

# Execution limits
MAX_RESULT_ROWS=1000
STATEMENT_TIMEOUT_MS=15000
MAX_PLAN_COST=10000000

# Conversation
CONVERSATION_CONTEXT_TURNS=4
