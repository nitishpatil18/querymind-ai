# Docker Compose settings. Copy to .env and edit. Never commit .env.

# --- PostgreSQL ------------------------------------------------------------------------------------------
POSTGRES_DB=querymind
POSTGRES_USER=querymind
POSTGRES_PASSWORD=change_me_admin
# Read-only role created on first start; the only account the API uses.
QUERYMIND_RO_USER=querymind_ro
QUERYMIND_RO_PASSWORD=change_me_ro
# Published on 127.0.0.1 only (not reachable from other machines).
POSTGRES_PORT=5432

# --- Ports (all bound to 127.0.0.1) ----------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- LLM ------------------------------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Gemini 3+ thinking effort: minimal, low, medium, high. Empty uses the model default (slower).
LLM_THINKING_LEVEL=
# seconds to wait for one model answer; raise it when the provider is slow
LLM_TIMEOUT_SECONDS=60
# Get a key at https://aistudio.google.com/apikey . Keep it out of Git and out of images.
GOOGLE_API_KEY=

# --- Retrieval and limits (optional) ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=10
MAX_RESULT_ROWS=1000
STATEMENT_TIMEOUT_MS=15000
